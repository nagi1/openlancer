<Project>
  <!-- Kept out of the repo root so that it does not apply to the Librelancer submodule. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>OpenLancer contributors</Authors>
    <Copyright>Copyright (c) OpenLancer contributors 2026</Copyright>
    <!-- The version of the next release. A release changes only these two lines. The file version is 0.1.0.0, and the
         product version is 0.1.0-preview. tools/release.ps1 adds "+<commit>" to the product version. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
  </PropertyGroup>
  <!-- A Release build maps the repo folder to a neutral path, so the binaries and PDBs do not hold the folder of the
       build machine. Source Link is off, because its map holds the same folder and the repo URLs.
       Debug builds keep the real paths for the debugger. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=/_/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
</Project>

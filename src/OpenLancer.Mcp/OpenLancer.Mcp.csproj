<Project Sdk="Microsoft.NET.Sdk">

  <!-- The binding of the agent tools of the Studio to the official MCP C# SDK (milestone MCP1, section 5.1 of the
       MCP1 design): the tool table and the resources as MCP tools and resources, and the server without a window on
       stdio. Only this project and the editor host use types of the SDK, so a change of the protocol touches only them
       (risk R1). -->

  <ItemGroup>
    <ProjectReference Include="..\OpenLancer.Studio\OpenLancer.Studio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Apache License 2.0. NOTICE and release/third-party.json list it and its dependencies. Update the version in a
         separate commit with the snapshot test of the tool list (decision D703). -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenLancer.Tests" />
    <InternalsVisibleTo Include="OpenLancer.DataTests" />
  </ItemGroup>

</Project>

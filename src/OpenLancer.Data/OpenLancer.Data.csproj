<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AtomicFile.MoveOver calls the Windows rename through LibraryImport, which generates unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\Librelancer\src\LibreLancer.Data\LibreLancer.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule data of the data lists (milestone M21, decision D112). -->
    <EmbeddedResource Include="Editing\Lists\list-rules.json" LogicalName="OpenLancer.Data.Editing.Lists.list-rules.json" />
    <!-- The argument schema and the behavior prefabs of mission scripts (milestone M6a, decisions D524 and D525). -->
    <EmbeddedResource Include="Missions\mission-schema.json" LogicalName="OpenLancer.Data.Missions.mission-schema.json" />
    <EmbeddedResource Include="Missions\mission-prefabs.json" LogicalName="OpenLancer.Data.Missions.mission-prefabs.json" />
    <!-- The file lists of the known game builds (milestone M11a). The file name is the build id. They hold paths, sizes
         and hashes only. -->
    <EmbeddedResource Include="..\..\data-manifest\*.tsv" LogicalName="OpenLancer.Data.Games.%(Filename).tsv" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenLancer.Tests" />
    <!-- The retail proofs test the internal patch writer directly. -->
    <InternalsVisibleTo Include="OpenLancer.DataTests" />
  </ItemGroup>

</Project>

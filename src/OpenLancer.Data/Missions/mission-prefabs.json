{
  "// about": "The behavior prefabs of mission scripts (milestone M6a, section 8 of the M6a design, decision D524). The matcher runs the beat prefabs in their order, and the core triggers of one prefab in file order. A trigger is a member of at most one instance. Core matches are data. Member rules and the checks of the steps are a fixed set of functions in MissionPrefabs.cs. The files hold no retail name.",
  "events": [
    { "id": "atOnce", "label": "At once", "conditions": ["Cnd_True"] },
    { "id": "afterDelay", "label": "After a delay", "conditions": ["Cnd_Timer"] },
    { "id": "afterComm", "label": "After a comm line", "conditions": ["Cnd_CommComplete"] },
    { "id": "firstEnterSystem", "label": "On first enter system", "conditions": ["Cnd_SystemEnter", "Cnd_SpaceEnter"], "rule": "firstEnterSystem" },
    { "id": "enterBase", "label": "On enter base", "conditions": ["Cnd_BaseEnter"] },
    { "id": "enterRoom", "label": "On enter room", "conditions": ["Cnd_LocEnter"] },
    { "id": "enterArea", "label": "On enter area", "conditions": ["Cnd_DistVec", "Cnd_DistShip", "Cnd_DistVecLbl", "Cnd_DistCircle"], "rule": "inside" },
    { "id": "leaveArea", "label": "On leave area", "conditions": ["Cnd_DistVec", "Cnd_DistShip", "Cnd_DistVecLbl"], "rule": "outside" },
    { "id": "destroyed", "label": "On destroyed", "conditions": ["Cnd_Destroyed"] },
    { "id": "missionAnswer", "label": "On mission answer", "conditions": ["Cnd_MsnResponse"] }
  ],
  "prefabs": [
    { "id": "checkpoint", "name": "Checkpoint", "kind": "beat", "order": 1,
      "help": { "title": "Checkpoint", "whatItIs": "A save point, and the trigger that rebuilds the scene after a load.", "whatItWrites": "An Act_Save line and the [Trigger] section that it names." },
      "core": { "anyAction": ["Act_Save"] },
      "members": [ { "role": "restore", "label": "Restore", "rule": "saveTarget" } ],
      "fields": [
        { "id": "savesAt", "label": "Saves at", "from": { "role": "core", "trigger": true } },
        { "id": "restoresWith", "label": "Restores with", "from": { "role": "core", "actions": ["Act_Save"], "value": 0 } },
        { "id": "restoreWaitsFor", "label": "Restore waits for", "from": { "role": "restore", "condition": true } }
      ],
      "steps": [
        { "id": "restore", "name": "Restore trigger", "requires": "restore", "rules": ["M05"], "reason": "After a load, the mission continues at this trigger." },
        { "id": "rebuild", "name": "Scene rebuild", "check": "sceneRebuild", "reason": "After a load, the scene is empty until a trigger rebuilds it." }
      ] },
    { "id": "offer", "name": "Offer mission", "kind": "beat", "order": 2,
      "help": { "title": "Offer mission", "whatItIs": "A mission offer in a bar: the offer scene, and what happens when the player accepts or declines.", "whatItWrites": "Act_AddRTC lines and [Trigger] sections with Cnd_MsnResponse." },
      "core": { "condition": "Cnd_MsnResponse", "value": "accept" },
      "members": [
        { "role": "decline", "label": "Decline", "rule": "msnResponseTriggers" },
        { "role": "scene", "label": "Offer scene", "rule": "offerSceneTriggers" }
      ],
      "fields": [
        { "id": "offerScene", "label": "Offer scene", "from": { "role": "scene", "actions": ["Act_AddRTC"], "value": 0 }, "list": { "codec": "lines", "items": "base scenes" } },
        { "id": "onAccept", "label": "On accept", "from": { "role": "core", "trigger": true } },
        { "id": "onDecline", "label": "On decline", "from": { "role": "decline", "trigger": true }, "list": { "codec": "triggers", "items": "triggers" } }
      ],
      "steps": [
        { "id": "scene", "name": "Offer scene", "requires": "scene", "reason": "The player sees the offer in this scene." },
        { "id": "accept", "name": "Accept trigger", "requires": "core", "reason": "Without it, nothing happens when the player accepts." },
        { "id": "decline", "name": "Decline trigger", "requires": "decline", "reason": "Without it, the player cannot get the offer again after a decline." }
      ] },
    { "id": "spaceCutscene", "name": "Play space cutscene", "kind": "beat", "order": 3,
      "help": { "title": "Play space cutscene", "whatItIs": "A space cutscene: the trigger that starts it on an anchor ship, and the trigger that gives the camera back.", "whatItWrites": "An Act_CallThorn line and a later Act_RevertCam line." },
      "core": { "anyAction": ["Act_CallThorn"] },
      "members": [ { "role": "revert", "label": "Camera back", "rule": "firstRevertOnPath", "maxLinks": 6 } ],
      "fields": [
        { "id": "file", "label": "Cutscene file", "from": { "role": "core", "actions": ["Act_CallThorn"], "value": 0 } },
        { "id": "anchor", "label": "Anchor", "from": { "role": "core", "actions": ["Act_CallThorn"], "value": 1 } },
        { "id": "endsWhen", "label": "Ends when", "from": { "role": "revert", "condition": true } },
        { "id": "cameraBack", "label": "Camera back", "from": { "role": "revert", "trigger": true } }
      ],
      "steps": [
        { "id": "file", "name": "Cutscene file", "rules": ["M22", "M12"], "reason": "The game plays nothing without the file." },
        { "id": "anchor", "name": "Anchor", "rules": ["M06"], "reason": "The camera of the cutscene moves with the anchor ship." },
        { "id": "cameraBack", "name": "Camera back", "rules": ["G06"], "reason": "Without \"End camera\", the camera does not come back to the player." }
      ] },
    { "id": "branch", "name": "Branch", "kind": "beat", "order": 4, "claimsCore": false,
      "help": { "title": "Branch", "whatItIs": "An if and an else on the state of a trigger. Some watchers run when the trigger is active. The others run when it is not active.", "whatItWrites": "[Trigger] sections with Cnd_WatchTrigger, ON and OFF." },
      "core": { "watchedTarget": true },
      "members": [
        { "role": "on", "label": "If it is active", "rule": "watchersOn" },
        { "role": "off", "label": "If it is not active", "rule": "watchersOff" }
      ],
      "fields": [
        { "id": "tests", "label": "Tests trigger", "from": { "role": "core", "trigger": true } },
        { "id": "ifActive", "label": "If it is active", "from": { "role": "on", "trigger": true }, "list": { "codec": "triggers", "items": "triggers" } },
        { "id": "ifNotActive", "label": "If it is not active", "from": { "role": "off", "trigger": true }, "list": { "codec": "triggers", "items": "triggers" } }
      ],
      "steps": [
        { "id": "bothPaths", "name": "Both paths", "check": "bothPaths", "reason": "A branch needs both paths." },
        { "id": "stopEachOther", "name": "Watchers stop each other", "check": "watchersStopEachOther", "reason": "Without it, both paths can run one after the other." }
      ] },
    { "id": "ambush", "name": "Ambush", "kind": "beat", "order": 5,
      "help": { "title": "Ambush", "whatItIs": "Attackers that the mission spawns at a time or a place, and the reaction when they come.", "whatItWrites": "A [MsnRandEnc] section, Act_EnableEnc lines and a [Trigger] section with Cnd_EncLaunched." },
      "core": { "section": "MsnRandEnc" },
      "members": [
        { "role": "armedBy", "label": "Armed by", "rule": "encounterArmers" },
        { "role": "onSpawn", "label": "On spawn", "rule": "encounterReactions" }
      ],
      "fields": [
        { "id": "encounter", "label": "Encounter", "from": { "role": "core", "key": "nickname" } },
        { "id": "attackers", "label": "Attackers", "from": { "role": "core", "key": "attacker_rep_name" } },
        { "id": "startsBy", "label": "Starts by", "from": { "role": "core", "key": "activation_type" } },
        { "id": "armedBy", "label": "Armed by", "from": { "role": "armedBy", "trigger": true }, "list": { "codec": "triggers", "items": "triggers" } },
        { "id": "onSpawn", "label": "On spawn", "from": { "role": "onSpawn", "trigger": true }, "list": { "codec": "triggers", "items": "triggers" } }
      ],
      "steps": [
        { "id": "armed", "name": "Armed by a trigger", "requires": "armedBy", "reason": "The encounter never spawns until a trigger arms it." },
        { "id": "reaction", "name": "Reaction trigger", "requires": "onSpawn", "reason": "Without it, the attackers keep the attitudes of their faction." }
      ] },
    { "id": "spawnWave", "name": "Spawn wave", "kind": "beat", "order": 6,
      "help": { "title": "Spawn wave", "whatItIs": "A group of ships that spawns and gets orders and sides, and the triggers that wait until the ships are destroyed.", "whatItWrites": "A [Trigger] section with spawn lines, and [Trigger] sections with Cnd_Destroyed." },
      "core": { "anyAction": ["Act_SpawnShip", "Act_SpawnFormation"] },
      "members": [ { "role": "end", "label": "End", "rule": "destroyedWatchersOfSpawned", "shared": true } ],
      "fields": [
        { "id": "ships", "label": "Ships", "from": { "role": "core", "actions": ["Act_SpawnShip", "Act_SpawnFormation"], "value": 0 }, "list": { "codec": "lines", "items": "ships" } },
        { "id": "spawnWhen", "label": "Spawn when", "from": { "role": "core", "condition": true } },
        { "id": "orders", "label": "Orders", "from": { "role": "core", "actions": ["Act_GiveObjList"], "value": 1 }, "list": { "codec": "lines", "items": "orders" } },
        { "id": "sides", "label": "Sides", "from": { "role": "core", "group": "sides" }, "list": { "codec": "lines", "items": "attitude lines" } },
        { "id": "endsWhen", "label": "Ends when", "from": { "role": "end", "condition": true }, "list": { "codec": "triggers", "items": "triggers" } }
      ],
      "steps": [
        { "id": "ships", "name": "Ships to spawn", "rules": ["M06", "M07"], "reason": "A spawn of a missing name spawns nothing." },
        { "id": "sides", "name": "Sides", "check": "sidesOfSpawned", "reason": "Without attitude lines, the ships keep the attitudes of their faction." },
        { "id": "end", "name": "End trigger", "requires": "end", "reason": "Without it, nothing happens after the ships are destroyed." }
      ] },
    { "id": "destroyTargets", "name": "Destroy targets", "kind": "beat", "order": 7,
      "help": { "title": "Destroy targets", "whatItIs": "Objects that the player must destroy. Marks show them on the screen. A trigger waits until they are destroyed.", "whatItWrites": "Act_MarkObj lines and [Trigger] sections with Cnd_Destroyed." },
      "core": { "anyAction": ["Act_MarkObj"], "noAction": ["Act_SpawnShip", "Act_SpawnFormation", "Act_SpawnSolar", "Act_SpawnLoot", "Act_SpawnShipRel"] },
      "members": [ { "role": "done", "label": "Done", "rule": "destroyedWatchersOfMarked" } ],
      "fields": [
        { "id": "targets", "label": "Targets", "from": { "role": "core", "actions": ["Act_MarkObj"], "value": 0 }, "list": { "codec": "lines", "items": "targets" } },
        { "id": "doneWhen", "label": "Done when", "from": { "role": "done", "condition": true }, "list": { "codec": "triggers", "items": "triggers" } }
      ],
      "steps": [
        { "id": "marked", "name": "Targets marked", "check": "targetsMarked", "reason": "The player finds the targets by their marks." },
        { "id": "done", "name": "Done trigger", "requires": "done", "reason": "Without it, nothing happens after the targets are destroyed." }
      ] },
    { "id": "conversation", "name": "Conversation", "kind": "beat", "order": 8,
      "help": { "title": "Conversation", "whatItIs": "A chain of comm lines. Each line waits for the line before it.", "whatItWrites": "A chain of [Trigger] sections with comm lines and Cnd_CommComplete." },
      "core": { "chain": "comms" },
      "members": [ { "role": "chain", "label": "Line", "rule": "linearChain" } ],
      "fields": [
        { "id": "lines", "label": "Lines", "from": { "role": "all", "group": "comms" }, "list": { "codec": "lines", "items": "comm lines" } },
        { "id": "startsWhen", "label": "Starts when", "from": { "role": "core", "condition": true } }
      ],
      "steps": [
        { "id": "commLines", "name": "Comm lines exist", "rules": ["M21"], "reason": "The game plays no sound for a missing comm line." }
      ] },
    { "id": "success", "name": "Mission success", "kind": "beat", "order": 9,
      "help": { "title": "Mission success", "whatItIs": "The end of the mission with success: the reward, the reputation changes, the log text and the end scene.", "whatItWrites": "A [Trigger] section with Act_ChangeState = SUCCEED." },
      "core": { "actionValue": { "action": "Act_ChangeState", "value": "SUCCEED" } },
      "members": [],
      "fields": [
        { "id": "reward", "label": "Reward", "from": { "role": "core", "actions": ["Act_AdjAcct"], "value": 0 } },
        { "id": "reputation", "label": "Reputation changes", "from": { "role": "core", "actions": ["Act_SetRep"], "value": 1 }, "list": { "codec": "lines", "items": "reputation lines" } },
        { "id": "log", "label": "Log text", "from": { "role": "core", "actions": ["Act_NNIds"], "value": 0 }, "list": { "codec": "lines", "items": "log lines" } },
        { "id": "endScene", "label": "End scene", "from": { "role": "core", "actions": ["Act_AddRTC"], "value": 0 } }
      ],
      "steps": [] },
    { "id": "fail", "name": "Mission fail", "kind": "beat", "order": 10,
      "help": { "title": "Mission fail", "whatItIs": "The end of the mission with fail, and the text that tells the player why.", "whatItWrites": "A [Trigger] section with Act_ChangeState = FAIL and a text id." },
      "core": { "actionValue": { "action": "Act_ChangeState", "value": "FAIL" } },
      "members": [],
      "fields": [
        { "id": "failText", "label": "Fail text", "from": { "role": "core", "actions": ["Act_ChangeState"], "value": 1 } }
      ],
      "steps": [
        { "id": "failText", "name": "Fail text", "rules": ["G04"], "reason": "The game shows this text when the mission fails." }
      ] },
    { "id": "keepApplying", "name": "Keep applying", "kind": "beat", "order": 11,
      "help": { "title": "Keep applying", "whatItIs": "A rule that the game applies again and again while the trigger is active, for example \"always friendly\".", "whatItWrites": "A [Trigger] section with repeatable = true and Cnd_True." },
      "core": { "repeatable": true, "condition": "Cnd_True" },
      "members": [],
      "fields": [ { "id": "applies", "label": "Applies", "from": { "role": "core", "allActions": true }, "list": { "codec": "lines", "items": "actions" } } ],
      "steps": [] },
    { "id": "setReputation", "name": "Set reputation", "kind": "beat", "order": 12,
      "help": { "title": "Set reputation", "whatItIs": "A trigger that only changes attitudes and reputations.", "whatItWrites": "A [Trigger] section with Act_SetVibe or Act_SetRep lines." },
      "core": { "allNonFlowInGroup": "sides" },
      "members": [],
      "fields": [
        { "id": "attitudes", "label": "Attitudes", "from": { "role": "core", "actions": ["Act_SetVibe", "Act_SetVibeLbl", "Act_SetVibeLblToShip", "Act_SetVibeShipToLbl"], "value": 0 }, "list": { "codec": "lines", "items": "attitude lines" } },
        { "id": "reputation", "label": "Reputation", "from": { "role": "core", "actions": ["Act_SetRep"], "value": 1 }, "list": { "codec": "lines", "items": "reputation lines" } }
      ],
      "steps": [] },
    { "id": "lockGate", "name": "Lock or unlock gate", "kind": "beat", "order": 13,
      "help": { "title": "Lock or unlock gate", "whatItIs": "A trigger that only locks or unlocks docks and gates, for the player or for other ships.", "whatItWrites": "A [Trigger] section with Act_LockDock lines." },
      "core": { "allNonFlowActions": ["Act_LockDock"] },
      "members": [],
      "fields": [ { "id": "docks", "label": "Docks", "from": { "role": "core", "actions": ["Act_LockDock"], "value": 1 }, "list": { "codec": "lines", "items": "docks" } } ],
      "steps": [] },
    { "id": "objective", "name": "Objective", "kind": "beat", "order": 14,
      "help": { "title": "Objective", "whatItIs": "A trigger that only sets the objective and its texts.", "whatItWrites": "A [Trigger] section with objective and text lines." },
      "core": { "allNonFlowInGroup": "objective" },
      "members": [],
      "fields": [
        { "id": "objective", "label": "Objective", "from": { "role": "core", "actions": ["Act_SetNNObj"], "value": 0 } },
        { "id": "state", "label": "State", "from": { "role": "core", "actions": ["Act_SetNNState"], "value": 1 } },
        { "id": "title", "label": "Title", "from": { "role": "core", "actions": ["Act_SetTitle"], "value": 0 } },
        { "id": "log", "label": "Log text", "from": { "role": "core", "actions": ["Act_NNIds"], "value": 0 }, "list": { "codec": "lines", "items": "log lines" } }
      ],
      "steps": [] },
    { "id": "watchedState", "name": "Watched state", "kind": "beat", "order": 15,
      "help": { "title": "Watched state", "whatItIs": "A trigger with a condition and no actions. Other triggers watch its state.", "whatItWrites": "A [Trigger] section with one Cnd_ line and no Act_ lines." },
      "core": { "noActions": true },
      "members": [],
      "fields": [ { "id": "waitsFor", "label": "Waits for", "from": { "role": "core", "condition": true } } ],
      "steps": [] },
    { "id": "escort", "name": "Escort", "kind": "order",
      "help": { "title": "Escort", "whatItIs": "Orders that make a ship follow the player or another ship.", "whatItWrites": "An [ObjList] section with a Follow or FollowPlayer line." },
      "core": { "section": "ObjList", "anyKey": ["Follow", "FollowPlayer"] },
      "members": [ { "role": "givers", "label": "Given by", "rule": "ordersGivers" } ],
      "fields": [
        { "id": "follows", "label": "Follows", "from": { "role": "core", "key": "Follow" } },
        { "id": "distance", "label": "Distance", "from": { "role": "core", "key": "Follow", "value": 1 } }
      ],
      "steps": [] },
    { "id": "patrol", "name": "Patrol", "kind": "order",
      "help": { "title": "Patrol", "whatItIs": "Orders that make a ship fly along two or more points.", "whatItWrites": "An [ObjList] section with GotoVec or GotoSpline lines." },
      "core": { "section": "ObjList", "minKeys": { "keys": ["GotoVec", "GotoSpline"], "count": 2 }, "noKey": ["Dock"] },
      "members": [ { "role": "givers", "label": "Given by", "rule": "ordersGivers" } ],
      "fields": [ { "id": "waypoints", "label": "Waypoints", "from": { "role": "core", "keys": ["GotoVec", "GotoSpline"] }, "list": { "codec": "lines", "items": "waypoints" } } ],
      "steps": [] }
  ]
}

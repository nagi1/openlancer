<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copies the Librelancer natives and dll.config files next to the tool. -->
  <Import Project="..\..\external\Librelancer\src\PublishAssets\PublishAssets.projitems" Label="Shared" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>oltool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLancer.Runtime\OpenLancer.Runtime.csproj" />
    <!-- oltool mcp: the agent server without a window, the replay and the tool list (milestone MCP1). -->
    <ProjectReference Include="..\OpenLancer.Mcp\OpenLancer.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The editor serves the agent server with ASP.NET Core (milestone MCP1), and this program runs from the folder of
         the editor. The shared framework of ASP.NET Core then gives the Microsoft.Extensions assemblies of the folder,
         so each program of the folder uses that framework too. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

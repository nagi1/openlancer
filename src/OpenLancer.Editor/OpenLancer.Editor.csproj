<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copies the Librelancer natives (cimgui, SDL3 and others) next to the editor. -->
  <Import Project="..\..\external\Librelancer\src\PublishAssets\PublishAssets.projitems" Label="Shared" />
  <!-- Compiles the editor shaders in Shaders\ and embeds each one as <name>.bin. -->
  <Import Project="..\..\external\Librelancer\src\Shader.targets" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OpenLancer.Editor</AssemblyName>
    <!-- ImGui draw-list callbacks take pointer arguments. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\Librelancer\src\Editor\LibreLancer.ImUI\LibreLancer.ImUI.csproj" />
    <ProjectReference Include="..\OpenLancer.Runtime\OpenLancer.Runtime.csproj" />
    <!-- The shared command layer: the commands and the edit helpers without an ImGui call. -->
    <ProjectReference Include="..\OpenLancer.Studio\OpenLancer.Studio.csproj" />
    <!-- The editor validates a save out of process with oltool, so oltool goes next to the editor. -->
    <ProjectReference Include="..\OpenLancer.Tools\OpenLancer.Tools.csproj" />
    <!-- Play runs the game in its own process, so the play program goes next to the editor. -->
    <ProjectReference Include="..\OpenLancer.Play\OpenLancer.Play.csproj" />
    <!-- The agent server of the editor (milestone MCP1): the SDK binding of the agent tools. -->
    <ProjectReference Include="..\OpenLancer.Mcp\OpenLancer.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The agent server of the editor serves Streamable HTTP with Kestrel on 127.0.0.1 (section 6.1 of the MCP1 design).
         The package is Apache License 2.0. NOTICE and release/third-party.json list it. The ASP.NET Core shared framework
         is MIT, as part of the .NET runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Shader Include="Shaders\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests check the editor logic that needs no GPU, for example the workspace layout. -->
    <InternalsVisibleTo Include="OpenLancer.Tests" />
    <!-- The retail proofs of the cutscene editor use the edits of the Timeline and the Inspector. -->
    <InternalsVisibleTo Include="OpenLancer.DataTests" />
  </ItemGroup>

</Project>

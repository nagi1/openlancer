+    // Finishes each world. After this, RequestWorld gives no world and LoadWorld makes none.
+    public void Close()
+    {
+        lock (closeLock)
+        {
+            if (closed) return;
+            closed = true;
+            foreach (var ws in worlds.Values) ws.World?.Finish();
+            worlds.Clear();
+        }
+    }

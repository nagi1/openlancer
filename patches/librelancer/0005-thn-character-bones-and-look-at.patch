+    internal static StartIKEvent HeadAtMarker(float duration, float transition) => new()
+    {
+        Duration = duration,
+        TransitionDuration = transition,
+        Targets = ["trent", "marker"],
+        EndEffector = "Body_Head",
+        CountToRoot = 1,
+        TargetType = TargetTypes.Root,
+        Up = ThnAxis.NegYAxis,
+        Front = ThnAxis.ZAxis,
+        PointAt = true
+    };

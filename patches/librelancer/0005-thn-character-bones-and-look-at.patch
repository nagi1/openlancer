@@ -0,0 +1,95 @@
+using System;
+using System.IO;
+using LibreLancer.Data.IO;
+using LibreLancer.Data.Schema;
+using LibreLancer.Data.Schema.Characters;
+using LibreLancer.Render;
+using LibreLancer.Resources;
+using LibreLancer.Utf.Anm;
+using LibreLancer.Utf.Dfm;
+using LibreLancer.World;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+// The retail Freelancer data. OPENLANCER_BASE gives the folder that contains DATA and EXE.
+// A test that uses this data is skipped when the folder does not exist.
+public class RetailData
+{
+    private const string DefaultFolder = @"D:\Projects\Freelancer Decompiled\GameData\base";
+
+    public readonly string Folder;
+    public readonly FileSystem VFS;
+    private readonly FreelancerIni ini;
+    private readonly CostumesIni costumes;
+    private readonly BodypartsIni bodyparts;
+    private readonly ServerResourceManager resources;
+
+    private RetailData(string folder)
+    {
+        Folder = folder;
+        VFS = FileSystem.FromPath(folder);
+        ini = new FreelancerIni(VFS);
+        costumes = new CostumesIni(ini.CostumesPath!, VFS);
+        bodyparts = new BodypartsIni(ini.BodypartsPath!, new FreelancerData(ini, VFS));
+        resources = new ServerResourceManager(null, VFS);
+    }
+
+    public static RetailData Open()
+    {
+        var folder = Environment.GetEnvironmentVariable("OPENLANCER_BASE");
+        if (string.IsNullOrEmpty(folder))
+        {
+            folder = DefaultFolder;
+        }
+
+        Assert.SkipUnless(Directory.Exists(folder), $"No retail data in {folder}. Set OPENLANCER_BASE.");
+        return new RetailData(folder);
+    }
+
+    // Reads a file that a THN script includes, as GameItemDb.ThornReadCallback does.
+    public byte[] ReadThornFile(string file) => VFS.ReadAllBytes("EXE/" + file);
+
+    // Makes the skeleton of a costume, as ThnScriptInstance does for a DEFORMABLE entity.
+    public DfmSkeletonManager? LoadCostume(string nickname)
+    {
+        var costume = costumes.FindCostume(nickname);
+        var body = LoadBodypart(costume?.Body);
+        if (costume == null || body == null)
+        {
+            return null;
+        }
+
+        return new DfmSkeletonManager(body, LoadBodypart(costume.Head), LoadBodypart(costume.LeftHand),
+            LoadBodypart(costume.RightHand));
+    }
+
+    // Makes the skeleton of a costume and loops an animation on it. The pose is the pose at 0.5 s.
+    public DfmSkeletonManager LoadPosedCostume(string nickname, string animations, string script)
+    {
+        var skeleton = LoadCostume(nickname)!;
+        skeleton.StartScript(LoadAnimations(animations).Scripts[script], 0, 1, 0, true);
+        skeleton.UpdateScripts(0.5);
+        return skeleton;
+    }
+
+    private DfmFile? LoadBodypart(string? nickname)
+    {
+        var mesh = nickname == null ? null : bodyparts.FindBodypart(nickname)?.Mesh;
+        return mesh == null ? null : (DfmFile?)resources.GetDrawable(ini.DataPath + mesh)?.Drawable;
+    }
+
+    // Makes the object of a rigid model, as ThnScriptInstance does for a COMPOUND entity. The object draws nothing.
+    public GameObject LoadModel(string path) =>
+        new(resources.GetDrawable(ini.DataPath + path)!, resources, false, false);
+
+    // Loads one file of character animations, as GameDataManager.GetCharacterAnimations does.
+    public AnmFile LoadAnimations(string path)
+    {
+        var anm = new AnmFile();
+        using var stream = VFS.Open(ini.DataPath + path);
+        AnmFile.ParseToTable(anm.Scripts, anm.Buffer, new StringDeduplication(), stream, path);
+        anm.Buffer.Commit();
+        return anm;
+    }
+}
diff --git a/src/LibreLancer.Tests/ThnCharacterBoneTests.cs b/src/LibreLancer.Tests/ThnCharacterBoneTests.cs
new file mode 100644
index 00000000..aec78ef6
--- /dev/null
+++ b/src/LibreLancer.Tests/ThnCharacterBoneTests.cs
@@ -0,0 +1,206 @@
+using System;
+using System.Numerics;
+using LibreLancer.Render;
+using LibreLancer.Thn;
+using LibreLancer.Thn.Events;
+using LibreLancer.World;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+// Uses Trent from the retail data: pl_trent_body, pi_pirate5_head and the benchmark male hands.
+// The ship tests use li_elite.
+public class ThnCharacterBoneTests
+{
+    private const float Tolerance = 1e-4f;
+    private static readonly Quaternion Turn = Quaternion.CreateFromAxisAngle(Vector3.UnitY, 1);
+
+    // The tests use an animated pose, because cutscenes read the bones after animation.
+    private static DfmSkeletonManager StandingTrent() => RetailData.Open().LoadPosedCostume("trent",
+        @"CHARACTERS\ANIMATIONS\BodyGenericMale.anm", "Sc_MLBODY_STND_IDLE_000LV_xa_04");
+
+    private static void AssertNear(Vector3 expected, Vector3 actual)
+    {
+        Assert.True(Vector3.Distance(expected, actual) < Tolerance, $"Expected {expected}, got {actual}");
+    }
+
+    private static void AssertNear(Transform3D expected, Transform3D actual)
+    {
+        AssertNear(expected.Position, actual.Position);
+        Assert.True(MathF.Abs(Quaternion.Dot(expected.Orientation, actual.Orientation)) > 1 - Tolerance,
+            $"Expected {expected.Orientation}, got {actual.Orientation}");
+    }
+
+    [Fact]
+    public void BodyHeadHasTheFrameThatTheIKEventsUse()
+    {
+        var skeleton = StandingTrent();
+        var root = skeleton.GetBone("Root")!.Transform;
+        var head = skeleton.GetBone("Body_Head")!.Transform;
+
+        Assert.InRange(head.Position.Y - root.Position.Y, 0.6f, 0.75f);
+        // The IK events give Body_Head up = NEG_Y_AXIS and front = Z_AXIS. The model faces -Z.
+        Assert.InRange(Vector3.Dot(Vector3.Transform(-Vector3.UnitY, head.Orientation), Vector3.UnitY), 0.9f, 1f);
+        Assert.InRange(Vector3.Dot(Vector3.Transform(Vector3.UnitZ, head.Orientation), -Vector3.UnitZ), 0.9f, 1f);
+        // Head_End is an IK target at the face. It is about 0.16 m in front of Body_Head.
+        var headEnd = head.InverseTransform(skeleton.GetBone("Head_End")!.Transform.Position);
+        Assert.InRange(Vector3.Distance(new Vector3(0, 0, 0.16f), headEnd), 0f, 0.02f);
+    }
+
+    [Fact]
+    public void RootIsTheBodyRoot()
+    {
+        var skeleton = StandingTrent();
+
+        AssertNear(skeleton.BodySkinning.Bones["Root"].LocalTransform, skeleton.GetBone("Root")!.Transform);
+    }
+
+    [Fact]
+    public void HeadAndHandBonesGoThroughTheirConnection()
+    {
+        var skeleton = StandingTrent();
+        skeleton.GetTransforms(Matrix4x4.Identity, out var head, out var leftHand, out var rightHand);
+
+        AssertNear(skeleton.HeadSkinning!.Bones["Eye IK Left"].LocalTransform * Transform3D.FromMatrix(head),
+            skeleton.GetBone("Eye IK Left")!.Transform);
+        AssertNear(skeleton.LeftHandSkinning!.Bones["L Index 1"].LocalTransform * Transform3D.FromMatrix(leftHand),
+            skeleton.GetBone("L Index 1")!.Transform);
+        AssertNear(skeleton.RightHandSkinning!.Bones["R Index 1"].LocalTransform * Transform3D.FromMatrix(rightHand),
+            skeleton.GetBone("R Index 1")!.Transform);
+    }
+
+    [Fact]
+    public void AnUnknownNameGivesNull()
+    {
+        Assert.Null(StandingTrent().GetBone("No Such Bone"));
+    }
+
+    private static ThnSceneObject Character(DfmSkeletonManager skeleton, Vector3 spot) => new()
+    {
+        Name = "target",
+        Translate = spot,
+        Rotate = Turn,
+        Object = new GameObject() { RenderComponent = new CharacterRenderer(skeleton) }
+    };
+
+    // Attaches a marker to the target for 50 s and runs the events of the first frame.
+    private static (ThnScriptInstance Instance, ThnSceneObject Marker) AttachScene(ThnSceneObject target,
+        TargetTypes type, string part)
+    {
+        var script = new ThnScript() { Duration = 100 };
+        script.Events.Add(new AttachEntityEvent()
+        {
+            Duration = 50,
+            Targets = ["marker", target.Name],
+            TargetType = type,
+            TargetPart = part,
+            Flags = AttachFlags.Position | AttachFlags.Orientation
+        });
+        var instance = new ThnScriptInstance(null!, script);
+        var marker = new ThnSceneObject() { Name = "marker", Rotate = Quaternion.Identity };
+        instance.Objects[marker.Name] = marker;
+        instance.Objects[target.Name] = target;
+        instance.Update(0);
+        return (instance, marker);
+    }
+
+    private static Transform3D TransformOf(ThnSceneObject obj) => new(obj.Translate, obj.Rotate);
+
+    // ThnSceneObject.UpdateEngineObjects puts the character model at the floor height plus the root height.
+    // This height replaces the Y of the scene position. A marker on a bone or on a hardpoint must stay on the model.
+    [Theory]
+    [InlineData(TargetTypes.Part, "Body_Head")]
+    [InlineData(TargetTypes.Part, "Eye IK Left")]
+    [InlineData(TargetTypes.Hardpoint, "hp_head")]
+    public void AMarkerOnACharacterFollowsTheModel(TargetTypes type, string part)
+    {
+        var skeleton = StandingTrent();
+        // A zero time step keeps the pose and stops the root motion. Thus the model stays on the scene spot.
+        skeleton.UpdateScripts(0);
+        // Retail base scenes put a character at its floor height. An example is character_trent in
+        // Rh_04_Shipdealer_enter_01, with Y = floor_height = 1.76.
+        skeleton.FloorHeight = 1.76f;
+        var character = Character(skeleton, new Vector3(5, 1.76f, -3));
+        var (_, marker) = AttachScene(character, type, part);
+        // The marker updates first, so it reads the scene position of the character.
+        marker.Update();
+        character.Update();
+
+        var local = type == TargetTypes.Part ? skeleton.GetBone(part)! : skeleton.Hardpoints[part];
+        AssertNear(local.Transform * character.Object!.WorldTransform, TransformOf(marker));
+        // The head of a standing man is about 1.7 m above the floor.
+        Assert.InRange(marker.Translate.Y - skeleton.FloorHeight, 1.5f, 1.9f);
+    }
+
+    // A marker on a bone reads the bone again on each frame. Each frame uses the order of Cutscene._Update: the
+    // events and processors, then the scene objects, then GameWorld.Update, which moves the bones.
+    [Theory]
+    [InlineData("Body_Head")]
+    [InlineData("Eye IK Left")]
+    public void AMarkerOnABoneFollowsTheAnimation(string bone)
+    {
+        var skeleton = StandingTrent();
+        var character = Character(skeleton, new Vector3(5, 1.76f, -3));
+        var (instance, marker) = AttachScene(character, TargetTypes.Part, bone);
+        var start = skeleton.GetBone(bone)!.Transform.Position;
+        var moved = 0f;
+
+        for (int i = 0; i < 40; i++)
+        {
+            instance.Update(0.1);
+            character.Update();
+            marker.Update();
+            var pose = skeleton.GetBone(bone)!.Transform;
+            AssertNear(pose * character.Object!.WorldTransform, TransformOf(marker));
+            moved = MathF.Max(moved, Vector3.Distance(start, pose.Position));
+            skeleton.UpdateScripts(0.1);
+        }
+
+        // The standing idle moves the head by some millimetres. The test is valid only if the bone moves.
+        Assert.True(moved > 10 * Tolerance, $"The bone moved only {moved} m");
+    }
+
+    // ROOT gives the scene position. A part that is not found gives ROOT.
+    [Theory]
+    [InlineData(TargetTypes.Root, "Body_Head")]
+    [InlineData(TargetTypes.Part, "No Such Bone")]
+    public void AMarkerOnTheCharacterRootKeepsTheScenePosition(TargetTypes type, string part)
+    {
+        var skeleton = StandingTrent();
+        skeleton.FloorHeight = 1.76f;
+        var spot = new Vector3(5, 1.76f, -3);
+        var (_, marker) = AttachScene(Character(skeleton, spot), type, part);
+        marker.Update();
+
+        AssertNear(new Transform3D(spot, Turn), TransformOf(marker));
+    }
+
+    // GetAttachParent also finds the parts and hardpoints of rigid models. The marker must be on the part or the
+    // hardpoint of the model. ThnScriptInstance mounts a ship on its HpMount, so the model is not at the scene
+    // position.
+    [Theory]
+    [InlineData(TargetTypes.Part, "Li_port_wing_lod1")]
+    [InlineData(TargetTypes.Hardpoint, "HpEngine01")]
+    public void AMarkerOnAShipFollowsTheModel(TargetTypes type, string part)
+    {
+        // li_elite has a turned wing part, and its HpMount is not at the origin.
+        var ship = RetailData.Open().LoadModel(@"SHIPS\LIBERTY\li_elite\li_elite.cmp");
+        var target = new ThnSceneObject()
+        {
+            Name = "target",
+            Translate = new Vector3(5, 1.76f, -3),
+            Rotate = Turn,
+            Object = ship,
+            HpMount = ship.GetHardpoint("HpMount")
+        };
+        Assert.NotNull(target.HpMount);
+        var (_, marker) = AttachScene(target, type, part);
+        marker.Update();
+        target.Update();
+
+        var local = type == TargetTypes.Part
+            ? ship.Model!.RigidModel.Parts[part].LocalTransform
+            : ship.GetHardpoint(part)!.Transform;
+        AssertNear(local * ship.WorldTransform, TransformOf(marker));
+    }
+}
diff --git a/src/LibreLancer.Tests/ThnRetailCorpusTests.cs b/src/LibreLancer.Tests/ThnRetailCorpusTests.cs
new file mode 100644
index 00000000..42300c02
--- /dev/null
+++ b/src/LibreLancer.Tests/ThnRetailCorpusTests.cs
@@ -0,0 +1,134 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using LibreLancer.Render;
+using LibreLancer.Thn;
+using LibreLancer.Thn.Events;
+using LibreLancer.Thorn;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+// Runs every cutscene in the retail data in the Thorn VM with the THN environment of the engine.
+// The tests read the script tables, not ThnScript: a ThnScript with a motion path needs the native
+// thorncompiler.
+public class ThnRetailCorpusTests
+{
+    private static IEnumerable<(string Path, Dictionary<string, object> Output)> Scripts(RetailData data)
+    {
+        foreach (var path in Directory.EnumerateFiles(data.Folder, "*.thn", SearchOption.AllDirectories))
+        {
+            yield return (path,
+                new ThornRunner(ThnScript.ThnEnv, data.ReadThornFile).DoBytes(File.ReadAllBytes(path), path));
+        }
+    }
+
+    // A DEFORMABLE entity gets the skeleton of the costume that its template names, as in ThnScriptInstance.
+    // An empty PART name is not checked, because GetAttachParent uses the root for it.
+    [Fact]
+    public void EveryBoneNameOnACharacterIsInItsCostume()
+    {
+        var data = RetailData.Open();
+        var skeletons = new Dictionary<string, DfmSkeletonManager?>(StringComparer.OrdinalIgnoreCase);
+        var failures = new List<string>();
+        var checkedNames = 0;
+
+        foreach (var (path, output) in Scripts(data))
+        {
+            var file = Path.GetFileName(path);
+            var templates = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+            foreach (var entity in ((ThornTable)output["entities"]).Values.Cast<ThornTable>())
+            {
+                if (ThnTypes.Convert<EntityTypes>(entity["type"]) == EntityTypes.Deformable)
+                {
+                    templates[(string)entity["entity_name"]] = (string)entity["template_name"];
+                }
+            }
+
+            void Check(float time, string entity, string? name, string kind)
+            {
+                if (!templates.TryGetValue(entity, out var template))
+                {
+                    return;
+                }
+
+                if (!skeletons.TryGetValue(template, out var skeleton))
+                {
+                    skeleton = data.LoadCostume(template);
+                    skeletons[template] = skeleton;
+                }
+
+                checkedNames++;
+                if (skeleton == null)
+                {
+                    failures.Add(FormattableString.Invariant($"{file} {time}: no costume {template} for {entity}"));
+                }
+                else if (skeleton.GetBone(name ?? "") == null)
+                {
+                    failures.Add(FormattableString.Invariant($"{file} {time}: {kind} '{name}' on {entity}"));
+                }
+            }
+
+            foreach (var ev in ((ThornTable)output["events"]).Values.Cast<ThornTable>())
+            {
+                if (!ev.TryGetValue(4, out var p))
+                {
+                    continue;
+                }
+
+                var time = (float)ev[1];
+                var targets = (ThornTable)ev[3];
+                var props = (ThornTable)p;
+                if (ThnTypes.Convert<EventTypes>(ev[2]) == EventTypes.StartIK)
+                {
+                    props.TryGetValue("end_effector", out var effector);
+                    Check(time, (string)targets[1], (string?)effector, "end_effector");
+                }
+
+                if (targets.Length > 1 && props.TryGetValue("target_type", out var type) &&
+                    ThnTypes.Convert<TargetTypes>(type) == TargetTypes.Part &&
+                    props.TryGetValue("target_part", out var part) && !string.IsNullOrEmpty((string)part))
+                {
+                    Check(time, (string)targets[2], (string)part, "target_part");
+                }
+            }
+        }
+
+        // The 1506 retail scripts name 7799 bones on characters.
+        Assert.Equal(7799, checkedNames);
+        // Retail has one START_IK event with an empty end_effector. No bone has that name.
+        Assert.Equal(["s072ab_offer_Quintaine_pl_09_Lab_01.thn 109.892: end_effector '' on Char_jacobi"], failures);
+    }
+
+    // StartIKEvent reads every retail START_IK event. 4808 of the 4825 events use only point_at.
+    [Fact]
+    public void EveryStartIKEventIsRead()
+    {
+        var count = 0;
+        var pointAt = 0;
+        foreach (var (path, output) in Scripts(RetailData.Open()))
+        {
+            foreach (var table in ((ThornTable)output["events"]).Values.Cast<ThornTable>())
+            {
+                if (ThnTypes.Convert<EventTypes>(table[2]) != EventTypes.StartIK)
+                {
+                    continue;
+                }
+
+                var ev = new StartIKEvent(table, path);
+                count++;
+                if (ev.PointAt && !ev.MoveTo)
+                {
+                    pointAt++;
+                }
+
+                Assert.Equal(2, ev.Targets.Length);
+                Assert.True(Enum.IsDefined(ev.Up) && Enum.IsDefined(ev.Front), $"{path} {ev.Time}: {ev.Up} {ev.Front}");
+            }
+        }
+
+        Assert.Equal(4825, count);
+        Assert.Equal(4808, pointAt);
+    }
+}
diff --git a/src/LibreLancer.Tests/ThnStartIKTests.cs b/src/LibreLancer.Tests/ThnStartIKTests.cs
new file mode 100644
index 00000000..aae8b539
--- /dev/null
+++ b/src/LibreLancer.Tests/ThnStartIKTests.cs
@@ -0,0 +1,779 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Linq;
+using System.Numerics;
+using System.Threading;
+using LibreLancer.Render;
+using LibreLancer.Thn;
+using LibreLancer.Thn.Events;
+using LibreLancer.Thorn;
+using LibreLancer.Utf.Anm;
+using LibreLancer.World;
+using LibreLancer.World.Components;
+using Xunit;
+
+namespace LibreLancer.Tests;
+
+// Uses Trent from the retail data in the standing idle. Each frame calls UpdateScripts and then ApplyIK, as
+// AnimationComponent does.
+public class ThnStartIKTests
+{
+    internal const float OneDegree = MathF.PI / 180;
+
+    // The character stands on a slope, so world up is not model up.
+    internal static readonly Transform3D World =
+        new(new Vector3(5, 1.76f, -3), Quaternion.CreateFromYawPitchRoll(1, 0.2f, 0.1f));
+
+    private static DfmSkeletonManager StandingTrent() => RetailData.Open().LoadPosedCostume("trent",
+        @"CHARACTERS\ANIMATIONS\BodyGenericMale.anm", "Sc_MLBODY_STND_IDLE_000LV_xa_04");
+
+    internal static void Frame(DfmSkeletonManager skeleton)
+    {
+        // A zero time step keeps the animation pose. Thus only IK changes the bones.
+        skeleton.UpdateScripts(0);
+        skeleton.ApplyIK(World);
+    }
+
+    internal static DfmSkeletonManager.IKGoal Goal(string bone, ThnAxis up, ThnAxis front, Vector3 target,
+        float weight = 1, int count = 1) => new()
+    {
+        Bone = bone,
+        CountToRoot = count,
+        Up = ThnTypes.AxisVector(up),
+        Front = ThnTypes.AxisVector(front),
+        TargetWorld = target,
+        Weight = weight
+    };
+
+    // The body, the head and the hands.
+    private static IEnumerable<DfmSkinning> Parts(DfmSkeletonManager skeleton) =>
+        new[] { skeleton.BodySkinning, skeleton.HeadSkinning, skeleton.LeftHandSkinning, skeleton.RightHandSkinning }
+            .OfType<DfmSkinning>();
+
+    internal static BoneInstance Bone(DfmSkeletonManager skeleton, string name) =>
+        Parts(skeleton).First(x => x.Bones.ContainsKey(name)).Bones[name];
+
+    // A point near a bone. The offset is in model space: -X is to the left of the character, +Y is up and -Z is
+    // to the front.
+    internal static Vector3 Near(DfmSkeletonManager skeleton, string bone, Vector3 offset) =>
+        World.Transform(skeleton.GetBone(bone)!.Transform.Position + offset);
+
+    // The world orientation of the IK axes of a bone. The IK axes do not include the Cons rotation of the bone.
+    private static Quaternion Axes(DfmSkeletonManager skeleton, string bone) =>
+        (skeleton.GetBone(bone)!.Transform * World).Orientation *
+        Quaternion.Inverse(Bone(skeleton, bone).OriginalRotation);
+
+    private static float Angle(Vector3 a, Vector3 b) =>
+        MathF.Acos(Math.Clamp(Vector3.Dot(Vector3.Normalize(a), Vector3.Normalize(b)), -1f, 1f));
+
+    private static float Angle(Quaternion q) => 2 * MathF.Acos(Math.Min(1f, MathF.Abs(q.W)));
+
+    // The angle between the front axis of a bone and the direction to the target.
+    private static float AngleToTarget(DfmSkeletonManager skeleton, string bone, ThnAxis front, Vector3 target) =>
+        Angle(Vector3.Transform(ThnTypes.AxisVector(front), Axes(skeleton, bone)),
+            target - (skeleton.GetBone(bone)!.Transform * World).Position);
+
+    internal static void AssertPointsAt(DfmSkeletonManager skeleton, string bone, ThnAxis front, Vector3 target)
+    {
+        var angle = AngleToTarget(skeleton, bone, front, target);
+        Assert.True(angle < OneDegree, $"{bone} points {angle / OneDegree} degrees away from the target");
+    }
+
+    // When an eye does not roll, the X axis of the joint in its Cons frame stays level and points to +X.
+    private static void AssertNoRoll(BoneInstance eye)
+    {
+        var joint = Quaternion.Inverse(eye.OriginalRotation) * eye.IKRotation * eye.Rotation * eye.OriginalRotation;
+        var x = Vector3.Transform(Vector3.UnitX, joint);
+        Assert.InRange(x.Y, -1e-3f, 1e-3f);
+        Assert.True(x.X > 0.8f, $"The eye rolls: its X axis is {x}");
+    }
+
+    // The eye limits are +-15 degrees of pitch, +-30 degrees of yaw and no roll. The eye must be inside the limits
+    // and at the yaw limit.
+    private static void AssertAtTheYawLimit(BoneInstance eye)
+    {
+        var joint = Quaternion.Inverse(eye.OriginalRotation) * eye.IKRotation * eye.Rotation * eye.OriginalRotation;
+        var front = Vector3.Transform(Vector3.UnitZ, joint);
+        Assert.InRange(MathF.Asin(-front.Y), -15.01f * OneDegree, 15.01f * OneDegree);
+        Assert.InRange(MathF.Abs(MathF.Atan2(front.X, front.Z)), 29.9f * OneDegree, 30.01f * OneDegree);
+        AssertNoRoll(eye);
+    }
+
+    private static void AssertNear(Transform3D expected, Transform3D actual)
+    {
+        Assert.True(Vector3.Distance(expected.Position, actual.Position) < 1e-4f,
+            $"Expected {expected.Position}, got {actual.Position}");
+        Assert.True(MathF.Abs(Quaternion.Dot(expected.Orientation, actual.Orientation)) > 1 - 1e-5f,
+            $"Expected {expected.Orientation}, got {actual.Orientation}");
+    }
+
+    internal static void AssertFinite(DfmSkeletonManager skeleton)
+    {
+        foreach (var skinning in Parts(skeleton))

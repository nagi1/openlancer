+                Math.Clamp(pitch, IKMin.X, IKMax.X), Math.Clamp(roll, IKMin.Z, IKMax.Z));
+            return OriginalRotation * joint * Quaternion.Inverse(OriginalRotation) * Quaternion.Inverse(Rotation);
+        }
     }

# Build output
bin/
obj/
artifacts/
.vs/
.idea/
*.user
*.suo
TestResults/

# Local output. Dumps, baselines and saves come from retail data.
out/

# The packages of the export hold merged game files (milestone M11). Never commit them.
exports/

# The save folder that the editor makes in a mod: staged files, the save journal and the recovery file.
.olsave/

# Local notes of each contributor. Git never commits them. Private plans stay outside the repo.
/notes/

# The build log of start.bat.
/logs/

# Retail Freelancer content must never enter this repo.
# The game data lives outside the repo, in ..\GameData\.
*.iso
*.cab
*.ttf
*.fl
*.lrpk
*.utf
*.cmp
*.3db
*.mat
*.txm
*.vms
*.sph
*.ale
*.anm
*.dfm
*.thn
*.sur
*.wmv
# The thumbnails of the editor show retail art (milestone M23). The editor keeps them outside each repository.
*.olthumb
# A THN patch of a mod holds only keys and changed values (decision D70). tools/content_scan.py checks it.
!**/patches/**/*.thn

# Personal mods stay out of git. Only the committed sample mods are tracked. Make your own mods in
# Documents\OpenLancer\mods or ..\GameData\mods (both outside the repo).
/samples/mods/*
!/samples/mods/ol-sample/

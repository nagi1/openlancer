<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copies the Librelancer natives next to the test assembly. The THN tests compile Lua text with
       x64\thorncompiler.dll. -->
  <Import Project="..\..\external\Librelancer\src\PublishAssets\PublishAssets.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The snapshot of the JSON tool list of oltool mcp tools (section 13.1, item 1 of the MCP1 design). A change of a
         tool is a diff of this file. -->
    <Content Include="AgentTools.snapshot.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenLancer.Data\OpenLancer.Data.csproj" />
    <ProjectReference Include="..\..\src\OpenLancer.Editor\OpenLancer.Editor.csproj" />
  </ItemGroup>

</Project>
